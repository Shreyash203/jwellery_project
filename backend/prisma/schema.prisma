generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model Order {
 id String @id @default(cuid())
 createdAt DateTime @default(now())
 customerName String
 email String
 phone String
 address String
 city String
 postalCode String
 total Int
 status String @default("PENDING_COD")
 items Json
}