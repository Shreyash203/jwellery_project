{
  "name": "jwellery-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test src/app.test.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "@prisma/client": "6.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/node": "^26.6.6",
    "prisma": "6.12.0",
    "typescript": "^5.9.3",
    "tsx": "^4.20.0"
  }
}